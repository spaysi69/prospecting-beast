+@app.delete('/api/jobs/{jid}/leads')
+async def delete_selected_leads(jid: str, payload: dict, _: bool = Depends(auth)):
+    job=await get_job(jid)
+    if not job: raise HTTPException(404,'job not found')
+    ids={str(x) for x in (payload.get('lead_ids') or []) if x is not None}
+    if not ids: return {'ok':True,'deleted':0}
+    rows=await sb_select('leads', params={'job_id':f'eq.{jid}','select':'id','limit':'5000'})
+    valid={str(r.get('id')) for r in rows or []}
+    deleted=0
+    for lead_id in ids & valid:
+        await sb_delete('leads', {'id':lead_id})
+        deleted += 1
+    await append_log(jid, f'Deleted {deleted} selected leads.', 'warning')
+    return {'ok':True,'deleted':deleted}
