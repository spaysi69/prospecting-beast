+class LeadDeleteIn(BaseModel):
+    lead_ids: list[str] = Field(min_length=1, max_length=500)
+
+@app.delete('/api/jobs/{jid}/leads')
+async def delete_selected_leads(jid: str, inp: LeadDeleteIn, _: bool = Depends(auth)):
+    job=await get_job(jid)
+    if not job: raise HTTPException(404,'job not found')
+    rows=await sb_select('leads', params={'job_id':f'eq.{jid}','id':f'in.({",".join(inp.lead_ids)})','select':'id','limit':'5000'})
+    deleted=0
+    for r in rows or []:
+        try:
+            await sb_delete('leads', {'id':r['id']})
+            deleted += 1
+        except Exception:
+            pass
+    return {'ok':True,'deleted':deleted}
