+def _infer_employee_band(pages: list[dict]) -> int | None:
+    """Best-effort headcount signal from first-party public text; never requires a paid source."""
+    text=' '.join(str(p.get('content','')) for p in pages[:8]).lower()
+    patterns=[
+        r'(\d[\d,]{2,})\s*\+?\s*(?:employees|people|team members|staff)',
+        r'(?:team of|more than)\s*(\d[\d,]{2,})\s*(?:employees|people)',
+    ]
+    vals=[]
+    for pat in patterns:
+        for m in re.finditer(pat, text):
+            try: vals.append(int(m.group(1).replace(',','')))
+            except ValueError: pass
+    return min(vals) if vals else None
+
+
+def auto_search_budget(domain: str, requested: int, official_pages: list[dict]) -> tuple[int,str]:
+    d=norm_domain(domain)
+    if d in MEGA_CORP_DOMAINS:
+        return min(4, max(1, int(requested or 4))), 'mega-corp'
+    headcount=_infer_employee_band(official_pages)
+    if headcount is not None and headcount < 500:
+        return min(12, max(1, int(requested or 12))), 'startup-under-500'
+    return max(1, min(int(requested or 6), 16)), 'standard'
+
